<?xml version="1.0" encoding="utf-8"?>
<!--
   API 31+ equivalent of backup_rules.xml (cloud backup and device-to-device
   transfer). Excludes the encrypted Gemini API key store for the same reason
   (planning.md §7.4) — it is meaningless on another device/Keystore anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="finai_ai_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="finai_ai_keys.xml" />
    </device-transfer>
</data-extraction-rules>
