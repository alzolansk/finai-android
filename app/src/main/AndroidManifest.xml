<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AI provider calls only (Fase 2/3, planning.md §9: Gemini/Groq/OpenRouter/Mistral/Cerebras) — the only network use in the app. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Notificações proativas (Fase 5, planning.md §9). Obrigatória a partir do Android 13
         (API 33) e pedida em runtime por MainActivity; sem ela o app funciona normalmente,
         só a notificação em si não aparece (FinaiNotifier degrada silenciosamente). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FinaiApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@style/Theme.FinAI">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FinAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
