# Modelo do arquivo de assinatura de release (Fase 6).
#
# COPIE este arquivo para `keystore.properties` na raiz do projeto e preencha
# com os SEUS valores. O arquivo real está no .gitignore e nunca deve ser
# commitado — nem ele, nem o .jks/.keystore que ele aponta.
#
# Sem `keystore.properties`, `./gradlew assembleRelease` continua funcionando e
# gera um APK NÃO assinado (útil para validar o R8 em CI). Com ele, o APK/AAB
# sai assinado e pronto para a Play Store.
#
# Como gerar o keystore (uma única vez — guarde o arquivo e as senhas em lugar
# seguro; perdê-lo significa nunca mais poder atualizar o app publicado, a menos
# que você use o Play App Signing, ver RELEASE.md):
#
#   keytool -genkeypair -v \
#     -keystore ~/chaves/finai-release.jks \
#     -alias finai \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# `storeFile` é resolvido a partir da RAIZ do projeto — use caminho absoluto se
# o keystore estiver fora do repositório, que é o recomendado.

storeFile=C:/Users/SEU_USUARIO/chaves/finai-release.jks
storePassword=
keyAlias=finai
keyPassword=
